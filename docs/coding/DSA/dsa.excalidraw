    },
    {
      "id": "qSw9yfHSdvS9Gri6l7LNH",
      "type": "text",
      "x": 1780.7779303656675,
      "y": 442.27777777777777,
      "width": 369.99969482421875,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aT",
      "roundness": null,
      "seed": 1287155711,
      "version": 223,
      "versionNonce": 628444788,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795659548695,
      "link": null,
      "locked": false,
      "text": "a contiguous box over the array. The\nright edge always moves forward.\nKeep a small summary of what's inside,\nupdated as elements enter on the\nright and leave on the left. If the\nsummary says the box is invalid, move\nthe left edge. Works when moving the\nleft edge reliably fixes things, like\nwith positive numbers.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "aaELrF4x5oZs70xG1jT-u",
      "originalText": "a contiguous box over the array. The right edge always moves forward. Keep a small summary of what's inside, updated as elements enter on the right and leave on the left. If the summary says the box is invalid, move the left edge. Works when moving the left edge reliably fixes things, like with positive numbers.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "tdXz12z4lGWiCgmRQWPti",
      "type": "ellipse",
